---
import Base from '../layouts/Base.astro';
import { getCollection, render } from 'astro:content';

export async function getStaticPaths() {
	const articles = await getCollection('articles');
	const pages = await getCollection('pages');

	const articlePaths = articles.map((a) => ({
		params: { id: a.id },
		props: { kind: 'article', entry: a },
	}));

	const pagePaths = pages.map((p) => ({
		params: { id: p.id },
		props: { kind: 'page', entry: p },
	}));

	return [...articlePaths, ...pagePaths];
}

const { kind, entry } = Astro.props;
const { Content } = await render(entry);
---
{kind === 'article' ? (
	<Base title={entry.data.title} description={entry.data.meta}>
		<article class="post">
			<a class="back" href="/">&larr; Back to home</a>
			<img class="featured" src={entry.data.image} alt={entry.data.title} onerror="this.style.display='none'" />
			<div class="cat">{entry.data.category}</div>
			<h1>{entry.data.title}</h1>
			<div class="meta">By {entry.data.author}</div>
			<div class="content"><Content /></div>
		</article>
	</Base>
) : (
	<Base title={entry.data.title}>
		<article class="post">
			<a class="back" href="/">&larr; Back to home</a>
			<h1>{entry.data.title}</h1>
			<div class="content"><Content /></div>
		</article>
	</Base>
)}

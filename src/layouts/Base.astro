---
import '../styles/global.css';
import { getCollection } from 'astro:content';
import { siteConfig } from '../site.config';

interface Props {
	title: string;
	description?: string;
	image?: string;
}
const { title, description = siteConfig.defaultDescription, image } = Astro.props;
const ogImage = image ? new URL(image, Astro.site).toString() : undefined;
const canonicalURL = new URL(Astro.url.pathname, Astro.site).toString();

const articles = await getCollection('articles');
const categories = [...new Set(articles.map((a) => a.data.category).filter(Boolean))];
---
<!DOCTYPE html>
<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width" />
		<title>{title}</title>
		<meta name="description" content={description} />
		<link rel="canonical" href={canonicalURL} />

		<meta property="og:type" content="website" />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta property="og:url" content={canonicalURL} />
		{ogImage && <meta property="og:image" content={ogImage} />}

		<meta name="twitter:card" content={ogImage ? 'summary_large_image' : 'summary'} />
		<meta name="twitter:title" content={title} />
		<meta name="twitter:description" content={description} />
		{ogImage && <meta name="twitter:image" content={ogImage} />}
	</head>
	<body>
		<header class="site-header">
			<a class="logo" href="/">{siteConfig.emoji} {siteConfig.domain}</a>
			<nav id="site-nav">
				<a href="/">Home</a>
				<a href="/archive/">Archive</a>
				{categories.map((c) => (
					<a href={`/category/${c?.toLowerCase().replace(/[^a-z0-9]+/g, '-').replace(/(^-|-$)/g, '')}/`}>{c}</a>
				))}
			</nav>
			<button id="menu-toggle" aria-label="Toggle menu" aria-expanded="false" aria-controls="site-nav">
				<svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
					<line x1="3" y1="6" x2="21" y2="6"></line>
					<line x1="3" y1="12" x2="21" y2="12"></line>
					<line x1="3" y1="18" x2="21" y2="18"></line>
				</svg>
			</button>
		</header>
		<div class="hero">
			<h1>{siteConfig.name}</h1>
			<p>{siteConfig.tagline}</p>
		</div>
		<slot />
		<footer class="site-footer">
			<nav class="footer-nav">
				<a href="/about-us/">About Us</a>
				<a href="/contact-us/">Contact Us</a>
				<a href="/privacy-policy/">Privacy Policy</a>
				<a href="/terms-of-use/">Terms of Use</a>
				<a href="/disclaimer/">Disclaimer</a>
			</nav>
			<p>{siteConfig.footerText}</p>
		</footer>
		<script>
			const btn = document.getElementById('menu-toggle');
			const nav = document.getElementById('site-nav');
			btn?.addEventListener('click', () => {
				const isOpen = nav?.classList.toggle('open');
				btn.setAttribute('aria-expanded', isOpen ? 'true' : 'false');
			});
		</script>
	</body>
</html>
